{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lighthouse:check": "bash ./scripts/lighthouse-check.sh",
    "test": "node --test \"tests/*.test.mjs\"",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
