# Copy to .dev.vars for local `npm run preview`. Never commit .dev.vars.
RESEND_API_KEY=re_xxxxxxxx
LEAD_NOTIFY_EMAIL_TO=you@example.com
# Optional. Cloudflare's always-pass test secret; pair it with the test site key
# 1x00000000000000000000AA in NEXT_PUBLIC_TURNSTILE_SITE_KEY at build time.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
