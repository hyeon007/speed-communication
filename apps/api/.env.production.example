PORT=3001

# production storage mode: use prisma
LEAD_STORAGE=prisma

# PostgreSQL (required in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sp?schema=public"

# Admin auth (replace before production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_EDITOR_USERNAME=admin
ADMIN_EDITOR_PASSWORD=change-me-please
ADMIN_OPERATOR_USERNAME=operator
ADMIN_OPERATOR_PASSWORD=change-me-operator
ADMIN_VIEWER_USERNAME=viewer
ADMIN_VIEWER_PASSWORD=change-me-viewer
JWT_SECRET=replace-this-secret-in-production
JWT_EXPIRES_IN_SECONDS=43200
CORS_ALLOWED_ORIGINS=https://example.com
ENABLE_SWAGGER=false

# set true only when x-forwarded-for is sanitized by your reverse proxy
RATE_LIMIT_TRUST_PROXY_HEADER=true

# Optional email notifications
LEAD_NOTIFY_EMAIL_ENABLED=false
LEAD_NOTIFY_EMAIL_SMTP_HOST=smtp.example.com
LEAD_NOTIFY_EMAIL_SMTP_PORT=587
LEAD_NOTIFY_EMAIL_SMTP_SECURE=false
LEAD_NOTIFY_EMAIL_SMTP_USER=
LEAD_NOTIFY_EMAIL_SMTP_PASS=
LEAD_NOTIFY_EMAIL_FROM=noreply@example.com
LEAD_NOTIFY_EMAIL_TO=ops@example.com
LEAD_NOTIFY_EMAIL_SUBJECT_PREFIX=[SP]
LEAD_NOTIFY_EMAIL_TIMEOUT_MS=5000
LEAD_NOTIFY_EMAIL_RETRY_COUNT=2
LEAD_NOTIFY_EMAIL_RETRY_DELAY_MS=1000
