generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  new
  in_progress
  completed
}

enum DeviceBrand {
  apple
  samsung
}

enum DevicePublicationStatus {
  draft
  published
  archived
}

model Lead {
  id               Int               @id @default(autoincrement())
  name             String
  phone            String
  interestDevice   String
  consultationType String?
  preferredCarrier String?
  contactTime      String
  memo             String?
  status           LeadStatus        @default(new)
  createdAt        DateTime          @default(now())
  statusAudits     LeadStatusAudit[]

  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("leads")
}

model LeadStatusAudit {
  id             Int        @id @default(autoincrement())
  leadId         Int
  previousStatus LeadStatus
  nextStatus     LeadStatus
  changedBy      String
  changedAt      DateTime   @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([changedAt])
  @@index([nextStatus, changedAt])
  @@index([leadId, changedAt])
  @@map("lead_status_audits")
}

model Device {
  id             Int                     @id @default(autoincrement())
  slug           String                  @unique
  brand          DeviceBrand
  name           String
  tagline        String
  description    String
  imageUrl       String?
  sourceUrl      String?
  colors         String[]
  storageOptions String[]
  highlights     String[]
  status         DevicePublicationStatus @default(draft)
  sortOrder      Int                     @default(0)
  releasedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status, sortOrder])
  @@index([brand, status, sortOrder])
  @@map("devices")
}
